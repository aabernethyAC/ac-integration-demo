# ActiveCampaign account API URL (no trailing slash), e.g. https://youraccount.api-us1.com
AC_API_URL=https://youraccount.api-us1.com
# Settings → Developer → API Access
AC_API_TOKEN=your_api_token_here

# Event Tracking (Website → Site Tracking → Event Tracking API)
AC_ACTID=your_9_digit_actid
AC_EVENT_KEY=your_event_key_here
